# Copy this file to .env and put your MySQL details here.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=stayzen

# Demo: nudges the demo hotel's crowd counts every minute so the heat map moves.
SIMULATE_CROWD=true

# Demo: lets the manager account switch between all verified hotels.
STAFF_DEMO_SWITCH=true
